# Mapbox Configuration
# Get your access token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Gateway origin for a real device/staging build. API_BASE_URL is a Dart
# compile-time define, not a dotenv runtime value; pass it explicitly with
# --dart-define=API_BASE_URL=... when building for a device or staging.
# API_BASE_URL=http://10.0.2.2:8079

# Example format:
# MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6ImNsZjJ6cWU5czBsM20za3M5NjU0c3g2ZGcifQ.example_token_string
